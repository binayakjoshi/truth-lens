</div>
<div class="hidden md:flex items-center gap-stack-lg">
<a class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors" href="#">Support</a>
<a class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors" href="#">Documentation</a>
</div>
</div>
</header>
<main class="flex-grow flex items-center justify-center pt-16 px-margin-mobile md:px-margin-desktop relative overflow-hidden">
<!-- Abstract Background Element -->
<div class="absolute inset-0 pointer-events-none opacity-40">
<div class="absolute top-[-10%] right-[-5%] w-[400px] h-[400px] bg-primary-fixed-dim blur-[120px] rounded-full"></div>
<div class="absolute bottom-[-10%] left-[-5%] w-[350px] h-[350px] bg-secondary-fixed-dim blur-[100px] rounded-full opacity-60"></div>
</div>
<!-- Login Container -->
<div class="w-full max-w-[440px] relative z-10">
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-stack-lg shadow-sm">
<!-- Brand Anchor Header -->
<div class="text-center mb-stack-lg">
<h1 class="font-headline-lg text-headline-lg text-on-surface mb-unit">Welcome back</h1>
<p class="font-body-sm text-body-sm text-on-surface-variant">Log in to your forensic workspace</p>
</div>
<!-- Social Login Buttons -->
<div class="grid grid-cols-2 gap-stack-md mb-stack-lg">
<button class="flex items-center justify-center gap-2 px-4 py-2.5 border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container transition-all active:scale-95">
<span class="material-symbols-outlined text-[18px]">account_circle</span>
                        Google
                    </button>
<button class="flex items-center justify-center gap-2 px-4 py-2.5 border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container transition-all active:scale-95">
<span class="material-symbols-outlined text-[18px]">terminal</span>
                        GitHub
                    </button>
</div>
<div class="relative flex items-center mb-stack-lg">
<div class="flex-grow border-t border-outline-variant"></div>
<span class="flex-shrink mx-4 font-label-sm text-label-sm text-outline">OR CONTINUE WITH EMAIL</span>
<div class="flex-grow border-t border-outline-variant"></div>
</div>
<!-- Login Form -->
<form class="space-y-stack-md" onsubmit="return false;">
<div>
<label class="block font-label-md text-label-md text-on-surface mb-unit" for="email">Email</label>
<input class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-surface text-body-md focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-outline-variant" id="email" placeholder="name@company.com" type="email"/>
</div>
<div>
<div class="flex justify-between items-center mb-unit">
<label class="block font-label-md text-label-md text-on-surface" for="password">Password</label>
<a class="font-label-sm text-label-sm text-primary hover:underline" href="#">Forgot password?</a>
</div>
<div class="relative">
<input class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-surface text-body-md focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder:text-outline-variant" id="password" placeholder="••••••••" type="password"/>
<button class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors" type="button">
<span class="material-symbols-outlined text-[20px]">visibility</span>
</button>
</div>
</div>
<div class="pt-unit">
<button class="w-full bg-primary text-on-primary font-label-md text-label-md py-3.5 rounded-lg hover:bg-surface-tint active:scale-[0.98] transition-all shadow-sm" type="submit">
                            Log in to TruthLens
                        </button>
</div>
</form>
<div class="mt-stack-lg pt-stack-lg border-t border-outline-variant text-center">
<p class="font-body-sm text-body-sm text-on-surface-variant">
