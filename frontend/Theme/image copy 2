<body class="bg-background text-on-background font-body-md min-h-screen flex flex-col selection:bg-primary-fixed-dim">
<!-- TopNavBar (Simplified for Auth Flow) -->
<header class="fixed top-0 w-full bg-background border-b border-outline-variant z-50">
<div class="max-w-container-max mx-auto px-margin-desktop flex items-center justify-between h-16">
